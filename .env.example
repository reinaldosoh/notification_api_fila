# Servidor
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Base URL pública (usada para montar a URL do webhook retornada pela API)
# Em produção no EasyPanel, ex: https://webhook.seudominio.com
PUBLIC_BASE_URL=http://localhost:3000

# Proteção da API administrativa (criar/listar/editar webhooks)
# Gere algo forte: openssl rand -hex 32
API_KEY=troque-essa-chave

# Proteção do Bull Board (dashboard da fila em /admin/queues)
ADMIN_USER=admin
ADMIN_PASSWORD=troque-essa-senha

# Postgres (guarda webhooks e histórico de execuções)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/webhooks

# Redis (usado pela fila BullMQ)
REDIS_URL=redis://localhost:6379

# Entrega / HTTP
DELIVERY_TIMEOUT_MS=30000
DELIVERY_MAX_ATTEMPTS=5
